<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 公文範本列表視圖 -->
    <record id="view_document_template_tree" model="ir.ui.view">
        <field name="name">wuchang.document.template.tree</field>
        <field name="model">wuchang.document.template</field>
        <field name="arch" type="xml">
            <tree string="公文範本">
                <field name="name"/>
                <field name="document_type"/>
                <field name="organization"/>
                <field name="usage_count"/>
                <field name="last_used_date"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- 公文範本表單視圖 -->
    <record id="view_document_template_form" model="ir.ui.view">
        <field name="name">wuchang.document.template.form</field>
        <field name="model">wuchang.document.template</field>
        <field name="arch" type="xml">
            <form string="公文範本">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="organization_type"/>
                            <field name="document_type"/>
                            <field name="organization"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="usage_count" readonly="1"/>
                            <field name="last_used_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="範本內容">
                            <field name="template_content" widget="html"/>
                        </page>
                        <page string="說明">
                            <field name="description" placeholder="輸入範本說明..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 公文範本搜尋視圖 -->
    <record id="view_document_template_search" model="ir.ui.view">
        <field name="name">wuchang.document.template.search</field>
        <field name="model">wuchang.document.template</field>
        <field name="arch" type="xml">
            <search string="搜尋公文範本">
                <field name="name"/>
                <field name="document_type"/>
                <field name="organization_type"/>
                <filter string="啟用" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="停用" name="inactive" domain="[('is_active', '=', False)]"/>
                <filter string="社區發展協會" name="filter_association" domain="[('organization_type', '=', 'association')]"/>
                <filter string="管委會" name="filter_committee" domain="[('organization_type', '=', 'committee')]"/>
                <group expand="0" string="分組">
                    <filter string="依組織類型" name="group_org_type" context="{'group_by': 'organization_type'}"/>
                    <filter string="依類型" name="group_type" context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 公文範本動作 -->
    <record id="action_document_template" model="ir.actions.act_window">
        <field name="name">公文範本</field>
        <field name="res_model">wuchang.document.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_document_template_search"/>
        <field name="context">{'default_organization': '新北市三重區五常社區發展協會'}</field>
    </record>

</odoo>
