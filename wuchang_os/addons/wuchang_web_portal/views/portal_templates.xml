                    <div id="xjWindowPortal" class="position-fixed bottom-0 end-0 m-4" style="display:none; width:360px; height:480px; z-index:9999;">
                        <div class="card shadow-lg" style="width:360px; height:480px; border-radius:12px; overflow:hidden;">
                            <iframe id="xjFramePortal" src="/xj/window/main" style="width:100%; height:100%; border:0"></iframe>
                        </div>
                    </div>
                    <script>
                    (function(){
                      var g=null;
                      function toggle(u){
                        var w=document.getElementById('xjWindowPortal');
                        var f=document.getElementById('xjFramePortal');
                        if(!w){return}
                        if(u){f.src=u}
                        w.style.display=(w.style.display==='none'?'block':'none');
                      }
                      function init(){
                        var btn=document.getElementById('xjCallBtnPortal');
                        btn.addEventListener('click', function(){
                          if(g){ toggle(g.front_path||g.front_url); return; }
                          fetch('/api/xj/clones',{method:'POST',headers:{'Content-Type':'application/json'}}).then(function(r){return r.json()}).then(function(d){
                            var c=(d.clones||[]).find(function(item){return item.key==='main'})||(d.clones||[])[0];
                            g=c||null;
                            toggle(g?(g.front_path||g.front_url):'/xj/window/main');
                          }).catch(function(){ toggle('/xj/window/main'); });
                        });
                        btn.addEventListener('keydown', function(e){
                          if(e.key==='Enter' || e.key===' '){ e.preventDefault(); btn.click(); }
                        });
                        document.addEventListener('keydown', function(e){
                          if(e.altKey && (e.key==='j' || e.key==='J')){ e.preventDefault(); btn.click(); }
                        });
                      }
                      document.addEventListener('DOMContentLoaded', init);
                    })();
                    </script>

