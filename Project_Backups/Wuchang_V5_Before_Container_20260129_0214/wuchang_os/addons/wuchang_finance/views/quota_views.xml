<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_wuchang_finance_quota_tree" model="ir.ui.view">
    <field name="name">wuchang.finance.quota.tree</field>
    <field name="model">wuchang.finance.quota</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="program"/>
        <field name="assigned_user_id" widget="many2one_avatar_user"/>
        <field name="monthly_limit"/>
        <field name="used_amount"/>
        <field name="remaining_amount"/>
        <field name="currency_id"/>
        <field name="status"/>
        <field name="last_update"/>
      </tree>
    </field>
  </record>

  <record id="view_wuchang_finance_quota_form" model="ir.ui.view">
    <field name="name">wuchang.finance.quota.form</field>
    <field name="model">wuchang.finance.quota</field>
    <field name="arch" type="xml">
      <form string="Credit Quota">
        <header>
          <button name="action_refresh" type="object" string="刷新" class="btn-primary"/>
          <field name="status" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="program"/>
            <field name="company_id"/>
            <field name="assigned_user_id"/>
          </group>
          <group>
            <field name="monthly_limit"/>
            <field name="used_amount"/>
            <field name="remaining_amount" readonly="1"/>
            <field name="currency_id"/>
          </group>
          <group>
            <field name="billing_account"/>
            <field name="project_id"/>
            <field name="source"/>
            <field name="last_update"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_wuchang_finance_quota" model="ir.actions.act_window">
    <field name="name">額度追蹤</field>
    <field name="res_model">wuchang.finance.quota</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_wuchang_finance_root" name="財務" parent="wuchang_core.menu_wuchang_root" sequence="80"/>
  <menuitem id="menu_wuchang_finance_quota" name="額度追蹤" parent="menu_wuchang_finance_root" action="action_wuchang_finance_quota" sequence="10"/>

</odoo>

