wuchang.global, app.wuchang.global {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @root path /
    redir @root https://wuchang.life 301

    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200
    reverse_proxy wuchang-web:8069
}

logecoffee.com, www.logecoffee.com, loge-coffee.life, www.loge-coffee.life {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200
    @root path /
    redir @root /ambassador 302
    reverse_proxy wuchang-web:8069
}
