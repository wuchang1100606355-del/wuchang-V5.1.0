# Caddyfile for Wuchang OS

{
    # 全域設定
}

:80 {
    encode zstd gzip
    header {
        -Server
    }

    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
    }

    respond /health 200

    reverse_proxy wuchang-web:8069 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
    }
}

wuchang.life, www.wuchang.life {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"
        -Server
    }

    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200

    # Map 3D Viewer route
    handle /map-3d-viewer {
        root * /usr/share/caddy
        try_files {path} /map_3d_viewer.html
        file_server
    }

    reverse_proxy wuchang-web:8069
}

odoo.wuchang.life {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200
    reverse_proxy wuchang-web:8069
}

