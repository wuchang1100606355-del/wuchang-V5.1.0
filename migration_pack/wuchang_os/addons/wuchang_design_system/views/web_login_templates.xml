    <template id="supreme_capture_page" name="Supreme Capture">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2>最高權限影像擷取</h2>
                <div class="alert alert-secondary">僅限最高權限，且需先完成驗證</div>
                <div class="row mt16">
                    <div class="col-md-6">
                        <video id="cam" autoplay="autoplay" playsinline="playsinline" class="w-100" style="max-height:300px;"></video>
                        <canvas id="canvas" class="d-none"></canvas>
                        <div class="mt-2">
                            <button id="btn_start" class="btn btn-outline-primary">開啟相機</button>
                            <button id="btn_capture" class="btn btn-primary ms-2">擷取並上傳</button>
                        </div>
                        <form id="upload_form" action="/supreme/capture" method="post" enctype="multipart/form-data" class="d-none">
                            <input type="file" id="image_file" name="image"/>
                        </form>
                    </div>
                </div>
                <script type="text/javascript">
                (function(){
                    var cam = document.getElementById('cam');
                    var cvs = document.getElementById('canvas');
                    var f = document.getElementById('upload_form');
                    var fileInput = document.getElementById('image_file');
                    var stream = null;
                    function start(){
                        navigator.mediaDevices.getUserMedia({ video: true }).then(function(s){ stream = s; cam.srcObject = s; }).catch(function(e){ alert('無法開啟相機：'+e); });
                    }
                    function toBlob(){
                        var w = cam.videoWidth; var h = cam.videoHeight; if (!w || !h) { alert('相機尚未就緒'); return null; }
                        cvs.width = w; cvs.height = h; var ctx = cvs.getContext('2d'); ctx.drawImage(cam, 0, 0, w, h);
                        return new Promise(function(resolve){ cvs.toBlob(resolve, 'image/png'); });
                    }
                    function upload(blob){
                        var dt = new DataTransfer(); var file = new File([blob], 'capture.png', { type: 'image/png' }); dt.items.add(file); fileInput.files = dt.files; f.submit();
                    }
                    document.getElementById('btn_start').addEventListener('click', start);
                    document.getElementById('btn_capture').addEventListener('click', function(){ toBlob().then(function(b){ if (b) upload(b); }); });
                })();
                </script>
            </div>
        </t>
    </template>
