    <template id="line_admin_page" name="LINE Admin">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2>LINE 管理設定</h2>
                <div class="alert alert-secondary">僅限創辦人或系統管理員</div>
                <div class="row mt16">
                    <div class="col-md-6">
                        <div class="mb-2">
                            <label class="form-label">Login Channel ID</label>
                            <input type="text" id="fld_channel_id" class="form-control" t-att-value="login_channel_id"/>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Login Channel Secret</label>
                            <input type="password" id="fld_channel_secret" class="form-control" placeholder="請貼入密鑰"/>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Callback URL</label>
                            <input type="text" id="fld_callback_url" class="form-control" t-att-value="callback_url" readonly="readonly"/>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="fld_provider_setup" checked="checked"/>
                            <label class="form-check-label" for="fld_provider_setup">建立/更新 Odoo OAuth Provider</label>
                        </div>
                        <div class="mt-3">
                            <button id="btn_save" class="btn btn-primary">保存設定</button>
                            <a href="/line/status" class="btn btn-outline-secondary ms-2">檢查狀態</a>
                            <a href="/line/connect" class="btn btn-outline-dark ms-2">前往連結頁</a>
                        </div>
                        <div id="result_box" class="mt-3"></div>
                    </div>
                </div>
                <script type="text/javascript">
                (function(){
                    var btn = document.getElementById('btn_save');
                    var box = document.getElementById('result_box');
                    function text(s){ box.innerText = s; }
                    function json(v){ box.textContent = JSON.stringify(v, null, 2); }
                    function save(){
                        var channel_id = document.getElementById('fld_channel_id').value.trim();
                        var channel_secret = document.getElementById('fld_channel_secret').value.trim();
                        var callback_url = document.getElementById('fld_callback_url').value.trim();
                        var provider_setup = !!document.getElementById('fld_provider_setup').checked;
                        text('執行中...');
                        fetch('/api/line/config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ channel_id: channel_id, channel_secret: channel_secret, callback_url: callback_url, provider_setup: provider_setup })
                        }).then(function(r){ return r.json(); }).then(function(d){ json(d); }).catch(function(e){ text(String(e)); });
                    }
                    if (btn) { btn.addEventListener('click', save); }
                })();
                </script>
            </div>
        </t>
    </template>
