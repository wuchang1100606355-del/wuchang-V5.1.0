                            <a t-att-href="liff_hood_link" target="_blank" rel="noopener" class="btn btn-success ms-2">里辦服務入口</a>
                        </t>
                    </div>
                </div>
                <div class="row mt16">
                    <div class="col-md-12">
                        <h3>商業平台</h3>
                        <t t-if="biz_add_link">
                            <a t-att-href="biz_add_link" target="_blank" rel="noopener" class="btn btn-outline-dark">加入官方帳號</a>
                        </t>
                        <t t-if="liff_biz_link">
                            <a t-att-href="liff_biz_link" target="_blank" rel="noopener" class="btn btn-dark ms-2">商業平台入口</a>
                        </t>
                    </div>
                </div>
                <div class="mt24">
                    <div class="alert alert-secondary" role="alert" aria-live="polite">
                        本服務由公益機構提供，不進行商業推銷與資料販售，僅用於身分辨識與提供服務。
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="agree_all" aria-describedby="agree_desc"/>
                        <label class="form-check-label" id="agree_desc" for="agree_all">我已詳閱並同意 <a href="https://wuchang.life/privacy" target="_blank" rel="noopener">隱私政策</a> 與 <a href="https://wuchang.life/terms" target="_blank" rel="noopener">使用條款</a></label>
                    </div>
                </div>
                <div class="mt24">
                    <a t-att-href="oauth_login_url or '/line/login'" id="login_btn" class="btn btn-dark btn-lg disabled" aria-disabled="true" aria-label="LINE 一鍵登入">LINE 一鍵登入</a>
                </div>
                <script type="text/javascript"><![CDATA[
                    (function(){
                        var a = document.getElementById('agree_all');
                        var b = document.getElementById('login_btn');
                        function hasConsent(){
                            return (document.cookie || '').split(';').some(function(x){
                                return x.trim().indexOf('wuchang_consent=') === 0 && x.indexOf('true') >= 0;
                            });
                        }
                        function setConsent(){
                            try {
                                document.cookie = 'wuchang_consent=true; max-age=31536000; path=/';
                            } catch(e) {}
                        }
                        function update(){
                            var ok = a && a.checked;
                            if (ok) { b.classList.remove('disabled'); b.setAttribute('aria-disabled','false'); }
                            else { b.classList.add('disabled'); b.setAttribute('aria-disabled','true'); }
                        }
                        function gate(e){
                            var ok = a && a.checked;
                            if (!ok) { e.preventDefault(); alert('請先勾選同意隱私政策與使用條款'); }
                            else { setConsent(); }
                        }
                        if (a && b) {
                            if (hasConsent()) { a.checked = true; }
                            a.addEventListener('change', update);
                            b.addEventListener('click', gate);
                            update();
                        }
                    })();
                ]]></script>
            </div>
        </t>
    </template>
