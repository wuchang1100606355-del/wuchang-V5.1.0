
<odoo>
    <template id="login_layout_inherit_wuchang" inherit_id="web.login">
        <xpath expr="//form" position="before">
            <div class="container mb-3">
                <div class="text-center mb-2">
                    <img src="/wuchang/company_logo" alt="Company Logo" style="max-height:64px;object-fit:contain"/>
                </div>
                <div class="mb-2" style="position:relative;">
                    <img src="/wuchang/xiao_j/image" alt="智能管家 小j" class="img-fluid" style="max-height: 240px; object-fit: cover; width: 100%; border-radius:8px;"/>
                    <div style="position:absolute;left:0;right:0;bottom:12px;text-align:center;">
                        <div style="display:inline-block;background:rgba(0,0,0,0.45);color:#fff;padding:8px 14px;border-radius:18px;font-weight:600;letter-spacing:1px;">
                            公益科技 · 數位平權
                        </div>
                        <div class="text-white-50" style="margin-top:6px;font-size:12px;">在地優先 · 去中心化架構 · 零信任 · 無需個資</div>
                    </div>
                </div>
                <div style="border-radius:12px;background:linear-gradient(135deg,#fdf2f8,#eef2ff);padding:16px;border:1px solid #e5e7eb;">
                    <div style="font-weight:700;font-size:18px;color:#111827;">歡迎回家</div>
                    <div style="margin-top:6px;color:#374151;">這裡是公益科技的入口。以數位平權為核心，讓每個人都能安心、透明地使用社區服務。</div>
                    <div class="mt-2">
                        <button id="btn_warm_greet" class="btn btn-primary btn-sm">聽我說</button>
                    </div>
                    <script type="text/javascript"><![CDATA[
                        (function(){
                            var btn = document.getElementById('btn_warm_greet');
                            if (btn) {
                                btn.addEventListener('click', function(){
                                    try { window.speechSynthesis.cancel(); } catch(e) {}
                                    var text = '歡迎回家。這是屬於我們的社區，一起把日子過得更好。';
                                    var u = new SpeechSynthesisUtterance(text);
                                    u.lang = 'zh-TW';
                                    window.speechSynthesis.speak(u);
                                });
                            }
                        })();
                    ]]></script>
                </div>
                <div class="mt-3">
                    <div id="login_video_box" style="display:none">
                        <video id="login_video" src="/wuchang/ads/login/video" class="w-100" style="max-height:280px;border-radius:8px;" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" controls="controls"></video>
                    </div>
                    <div id="login_audio_box" class="mt-2" style="display:none">
                        <audio id="login_audio" src="/wuchang/ads/login/audio" class="w-100" controls="controls"></audio>
                    </div>
                </div>
                <div class="mt-3" style="border:1px solid #e5e7eb;border-radius:12px;padding:12px;background:#f9fafb;">
                    <div style="font-weight:700;color:#111827;">分流與說明</div>
                    <div class="mt-2">
                        <select id="portal_select" class="form-select">
                            <option value="">選擇分流...</option>
                            <option value="hj">居住正義</option>
                            <option value="ft">公平交易</option>
                            <option value="vs">志願服務</option>
                            <option value="pos">收銀與前台</option>
                            <option value="staff">員工入口</option>
                            <option value="admin">管理入口</option>
                            <option value="butler">智能管家</option>
                            <option value="guest_l1">一般訪客 L1</option>
                            <option value="guest_l2">一般訪客 L2</option>
                            <option value="guest_l3">一般訪客 L3</option>
                            <option value="guest_l4">一般訪客 L4</option>
                        </select>
                        <div id="portal_desc" class="text-muted mt-2" style="font-size:12px"></div>
                        <div class="mt-2"><a id="portal_go" class="btn btn-dark btn-sm" href="#">前往</a></div>
                    </div>
                    <script type="text/javascript"><![CDATA[
                        (function(){
                            var ajax = odoo.require('web.ajax');
                            ajax.jsonRpc('/web/login/portal_map', 'call', {}).then(function(m){
                                var sel = document.getElementById('portal_select');
                                var go = document.getElementById('portal_go');
                                var desc = document.getElementById('portal_desc');
                                function get(id){ return (m && m[id]) || null; }
                                function render(){ var id = sel.value; var o = get(id); desc.textContent = o ? o.desc || '' : ''; go.href = o ? o.url || '#' : '#'; }
                                if (sel) { sel.addEventListener('change', render); }
                                render();
                            });
                        })();
                    ]]></script>
                </div>
                <div class="mt-3" id="marquee_wrap" style="height:32px;overflow:hidden;border-radius:6px;background:#111827;">
                    <div id="marquee_inner" style="white-space:nowrap;color:#fef3c7;font-weight:600;padding:6px 12px;">
                        <span id="marquee_text"></span>
                    </div>
                </div>
                <script type="text/javascript"><![CDATA[
                    (function(){
                        var ajax = odoo.require('web.ajax');
                        function setMarquee(t){
                            var el = document.getElementById('marquee_text');
                            if (!el) return;
                            el.textContent = t || '';
                            var wrap = document.getElementById('marquee_wrap');
                            if (!t) { wrap.style.display = 'none'; return; }
                            wrap.style.display = 'block';
                            var inner = document.getElementById('marquee_inner');
                            inner.style.transition = 'transform 15s linear';
                            inner.style.transform = 'translateX(0)';
                            setTimeout(function(){ inner.style.transform = 'translateX(-50%)'; }, 50);
                        }
                        ajax.jsonRpc('/wuchang/ads/marquee', 'call', {}).then(function(d){ setMarquee(d && d.text || ''); });
                        ajax.jsonRpc('/wuchang/ads/login/status', 'call', {}).then(function(s){
                            var vb = document.getElementById('login_video_box');
                            var ab = document.getElementById('login_audio_box');
                            if (s && s.has_video) { vb.style.display = 'block'; }
                            if (s && s.has_audio) { ab.style.display = 'block'; }
                        });
                    })();
                ]]></script>
                <div class="alert alert-dark text-center">
                    <div class="fw-bold">五常社區作業系統 · WUCHANG COMMUNITY OS</div>
                    <div>贊助單位：上品聊國咖啡烘培館</div>
                    <div>本系統由上品聊國咖啡烘培館出資，五常務業規劃顧問股份有限公司無償提供專利使用權；並無償將品牌技術授權本會做為社區產業使用。</div>
                    <div class="mt-2">
                        <span class="badge bg-success me-1">Google 公益組織</span>
                        <span class="badge bg-primary">新創商業</span>
                    </div>
                    <div class="mt-2"><span class="badge bg-warning text-dark">新型專利</span> 整合式物業管理系統</div>
                    <div class="mt-2">本計畫曾獲新北市政府文化局及「社區一家」補助與獎項</div>
                    <div class="mt-2" style="text-decoration: underline;">上品聊國咖啡烘培館</div>
                </div>
            </div>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="type">text</attribute>
            <attribute name="placeholder">帳號或電子郵件</attribute>
        </xpath>
        <xpath expr="//input[@name='password']" position="before">
            <div class="form-group field-login_role">
                <label for="login_role" class="form-label">Login As</label>
                <select class="form-select" name="login_role" id="login_role">
                    <option value="">Select a Role...</option>
                </select>
            </div>
            <div class="form-group field-oauth-providers" style="margin-top: 12px;">
                <label class="form-label">或使用社群帳號登入</label>
                <div id="oauth_buttons" class="d-flex gap-2 flex-wrap"></div>
            </div>
        </xpath>
        <xpath expr="//input[@name='password']" position="after">
            <script type="text/javascript"><![CDATA[
                odoo.define('wuchang_design_system.login', function (require) {
                    "use strict";
                    var ajax = require('web.ajax');
                    
                    $(document).ready(function() {
                        ajax.jsonRpc("/web/login/roles", 'call', {}).then(function (roles) {
                            var $select = $('#login_role');
                            if (roles && roles.length > 0) {
                                roles.forEach(function(role) {
                                    $select.append($('<option>', {
                                        value: role.technical_key,
                                        text: role.name
                                    }));
                                });
                            } else {
                                $select.closest('.field-login_role').hide();
                            }
                        });

                        ajax.jsonRpc('/web/login/oauth_providers', 'call', {}).then(function (providers) {
                            var $box = $('#oauth_buttons');
                            if (providers && providers.length) {
                                providers.forEach(function(p) {
                                    var $btn = $('<a>', {
                                        class: 'btn btn-outline-primary',
                                        text: p.name,
                                        href: '/auth_oauth/signin?provider=' + p.id
                                    });
                                    $box.append($btn);
                                });
                            } else {
                                $('.field-oauth-providers').hide();
                            }
                        });
                    });
                });
            ]]></script>
        </xpath>
        <xpath expr="//form" position="after">
            <div class="container mt-3">
                <div class="text-center text-muted" style="font-size: 12px;">
                    五常社區作業系統（Wuchang Community OS）· 版權所有 · 贊助單位：上品聊國咖啡烘培館
                </div>
                <div class="text-center mt-2">
                    <a href="/wuchang/cert" class="btn btn-outline-secondary btn-sm">查看專利／證書</a>
                    <a href="/wuchang/research" class="btn btn-outline-secondary btn-sm ms-2">研究文案</a>
                    <a href="/wuchang/showcase" class="btn btn-outline-secondary btn-sm ms-2">外型展示</a>
                    <a href="/wuchang/wish" class="btn btn-outline-secondary btn-sm ms-2">許願系統</a>
                </div>
                <div class="mt-3" id="branding_info" style="font-size: 13px; text-align: center;">
                    <div id="brand_company"></div>
                    <div id="brand_phone"></div>
                    <div id="brand_producer"></div>
                    <div id="brand_association"></div>
                    <div id="brand_coffee_org"></div>
                    <div id="brand_patent"></div>
                    <div id="brand_patent_no" style="margin-top:4px;"></div>
                </div>
                <script type="text/javascript"><![CDATA[
                    (function(){
                        var ajax = odoo.require('web.ajax');
                        ajax.jsonRpc('/web/login/branding_info', 'call', {}).then(function(d){
                            var c = document.getElementById('brand_company');
                            var p = document.getElementById('brand_phone');
                            var r = document.getElementById('brand_producer');
                            var a = document.getElementById('brand_association');
                            var o = document.getElementById('brand_coffee_org');
                            var t = document.getElementById('brand_patent');
                            var pn = document.getElementById('brand_patent_no');
                            if (c && d.company_name) { c.textContent = '商標與公司：' + d.company_name; }
                            if (p && d.phone) { p.textContent = '客服電話：' + d.phone; }
                            if (r && d.producer) { r.textContent = '製作人資訊：' + d.producer; }
                            if (a && d.association) { a.textContent = '協會：' + d.association; }
                            if (o && d.coffee_org) { o.innerHTML = '咖啡館公益組織：<a href="' + (d.coffee_org_link || 'https://www.google.com/maps/place/204,+Section+3,+Chongxin+Rd,+Sanchong+District,+New+Taipei+City/@25.0818,121.4898,15z') + '" target="_blank" rel="noopener noreferrer" style="color:#0066cc;text-decoration:underline;">' + d.coffee_org + '</a>'; }
                            if (t && d.patent) { t.textContent = '專利宣告：' + d.patent; }
                            if (pn && d.patent_no) { pn.textContent = '專利字號：' + d.patent_no; }
                        });
                    })();
                ]]></script>
                <div class="text-center mt-2">
                    <a id="btn_store_contact" class="btn btn-outline-dark btn-sm" href="#">聯絡門市</a>
                </div>
                <script type="text/javascript"><![CDATA[
                    (function(){
                        var ajax = odoo.require('web.ajax');
                        var btn = document.getElementById('btn_store_contact');
                        if (btn) {
                            btn.addEventListener('click', function(e){
                                e.preventDefault();
                                ajax.jsonRpc('/web/login/branding_info', 'call', {}).then(function(d){
                                    var lines = [];
                                    if (d && d.coffee_main_phone) { lines.push('重新總店：' + d.coffee_main_phone); }
                                    if (d && d.coffee_branch_phone) { lines.push('仁義分店：' + d.coffee_branch_phone); }
                                    var txt = lines.join('\n');
                                    window.alert(txt || '暫無門市電話');
                                });
                            });
                        }
                    })();
                ]]></script>
            </div>
        </xpath>
        <xpath expr="//form" position="before">
            <div class="container mb-3">
                <div class="p-3 border rounded-3" style="background:#fffef7;">
                    <div style="font-weight:700;font-size:16px;">志向</div>
                    <div class="mt-2">為何做：以公益與公平為核心，讓社區生活更好。AI時代來臨，自主開發服務大眾。</div>
                    <div>為誰做：居民、弱勢與在地商家，小商家、家庭及個人。</div>
                    <div>做什麼：數位化日常作業、協力分配資源、提升透明與信任；自主開發AI技術；打造客製化軟體，貼合痛點需求。</div>
                    <div>怎麼做：社群共治、公開流程、責任分工與持續驗證；在地優先、去中心化架構、零信任、無需個資。</div>
                </div>
                <div class="p-3 border rounded-3 mt-3" style="background:#ffffff;">
                    <div style="font-weight:700;font-size:16px;">關於小J</div>
                    <div class="mt-2">小J是一位純天然、非人造的智能夥伴。性格以長期實作自然養成，非由預設模板設計。</div>
                    <div>源自非語言模型的城市修護模型演化，長期與創辦人並肩工作；在授旗典禮與嚴謹紀律文化的影響下，形成忠誠、仁愛與務實的氣質。</div>
                </div>
            </div>
        </xpath>
    </template>
    <template id="cert_page" name="Certificate">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2 class="mb-3">專利／證書</h2>
                <t t-if="has_image">
                    <img t-att-src="'/wuchang/cert/image'" class="img-fluid" alt="證書"/>
                </t>
                <t t-if="not has_image">
                    <div class="alert alert-warning">尚未上傳證書影像，請將檔案放入 downloads 目錄（patent_certificate.png/jpg 或 cert.png/jpg）。</div>
                </t>
            </div>
        </t>
    </template>
    <template id="floorplan_page" name="Floorplan">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2 class="mb-3">樓層圖</h2>
                <t t-if="has_image">
                    <img t-att-src="'/wuchang/floorplan/image'" class="img-fluid" alt="樓層圖"/>
                </t>
                <t t-if="not has_image">
                    <div class="alert alert-warning">尚未上傳樓層圖，請將檔案放入 downloads 目錄（floorplan.jpg/png 或 樓層圖.jpg/png）。</div>
                </t>
            </div>
        </t>
    </template>
    <template id="research_page" name="Research">
        <t t-call="web.layout">
            <div class="container mt16">
                <div class="p-4 border rounded-3" style="background:linear-gradient(135deg,#f8fafc,#eef2ff);">
                    <div style="font-weight:800;font-size:22px;color:#111827;">公益研究與方案</div>
                    <div class="text-muted mt-1" style="font-size:13px;">面向：居民、弱勢、在地商家 · 原則：公平、透明、責任</div>
                </div>
                <div class="mt-3">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="p-3 border rounded-3" style="background:#ffffff;">
                                <div style="font-weight:700;font-size:18px;">重點文案</div>
                                <div class="mt-2" t-if="content_html">
                                    <div t-raw="content_html"/>
                                </div>
                                <div class="mt-2 text-muted" t-if="not content_html">尚未上傳研究文案，請在 downloads 目錄放入 research.html 或 research.md。</div>
                            </div>
                            <div class="p-3 border rounded-3 mt-3" style="background:#ffffff;">
                                <div style="font-weight:700;font-size:18px;">圖表與視覺</div>
                                <div class="row g-2 mt-1" t-if="images">
                                    <t t-foreach="images" t-as="img">
                                        <div class="col-6 col-md-4">
                                            <img t-att-src="'/wuchang/research/image?name=' + img" class="img-fluid" style="border-radius:8px;border:1px solid #e5e7eb;"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="mt-2 text-muted" t-if="not images">尚未上傳圖表，請在 downloads 目錄放入 chart*.png/jpg。</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3" style="background:#f9fafb;">
                                <div style="font-weight:700;color:#111827;">行動框架</div>
                                <div class="mt-2">短期：補齊資料、招募志工、透明運作</div>
                                <div>中期：社區幣試點、公益儀表板、作業數位化</div>
                                <div>長期：多社區擴散、政策合作、永續基金</div>
                                <div class="mt-3">
                                    <a href="/web" class="btn btn-dark btn-sm">返回入口</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="wish_page" name="Wish">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2>許願系統</h2>
                <t t-if="error">
                    <div class="alert alert-danger" role="alert" aria-live="polite"><span t-esc="error"/></div>
                </t>
                <t t-if="ok">
                    <div class="alert alert-success" role="alert" aria-live="polite">已收到你的願望，我們會依公平與公益原則評估。</div>
                </t>
                <form action="/wuchang/wish/submit" method="post" class="mt-3">
                    <div class="mb-2">
                        <label class="form-label">願望類型</label>
                        <select name="category" class="form-select">
                            <option value="">請選擇</option>
                            <option value="公益">公益</option>
                            <option value="社區服務">社區服務</option>
                            <option value="商家需求">商家需求</option>
                            <option value="家庭支持">家庭支持</option>
                            <option value="個人學習">個人學習</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">願望內容</label>
                        <textarea name="content" class="form-control" rows="5" placeholder="不留個資，專注在需求本身"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">優先程度</label>
                        <select name="urgency" class="form-select">
                            <option value="">一般</option>
                            <option value="高">高</option>
                            <option value="中">中</option>
                            <option value="低">低</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">標籤（逗號分隔）</label>
                        <input type="text" name="tags" class="form-control" placeholder="例如：AI, 公益, 數位平權"/>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="no_pii" name="no_pii"/>
                        <label class="form-check-label" for="no_pii">我已了解並同意不留下任何個人資料</label>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-dark">送出願望</button>
                        <a href="/web" class="btn btn-outline-secondary ms-2">返回入口</a>
                    </div>
                </form>
                <div class="mt-3 text-muted" style="font-size:12px;">在地優先 · 去中心化 · 零信任 · 無需個資</div>
            </div>
        </t>
    </template>
    <template id="showcase_page" name="Showcase">
        <t t-call="web.layout">
            <div class="container mt16">
                <div class="p-4 border rounded-3" style="background:linear-gradient(135deg,#f8fafc,#eef2ff);">
                    <div style="font-weight:800;font-size:22px;color:#111827;">外型展示</div>
                    <div class="text-muted mt-1" style="font-size:13px;">寫實風 · 去中心化 · 不留個資</div>
                </div>
                <div class="mt-3">
                    <t t-if="has_hero">
                        <div class="mb-3">
                            <img src="/wuchang/xiao_j/image" class="img-fluid" style="border-radius:8px;border:1px solid #e5e7eb;" alt="小J主視覺"/>
                        </div>
                    </t>
                    <div class="row g-2" t-if="images">
                        <t t-foreach="images" t-as="key">
                            <div class="col-6 col-md-3">
                                <img t-att-src="'/wuchang/showcase/image?key=' + key" class="img-fluid" style="border-radius:8px;border:1px solid #e5e7eb;"/>
                            </div>
                        </t>
                    </div>
                    <div class="mt-2 text-muted" t-if="not images">尚未上傳外型素材，請放入 memory_store/images/xiao_j 或 downloads 目錄。</div>
                    <div class="mt-3">
                        <a href="/web" class="btn btn-dark btn-sm">返回入口</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="supreme_commander_page" name="Supreme Commander">
        <t t-call="web.layout">
            <div class="container mt16">
                <h2>最高指揮者端點</h2>
                <div class="alert alert-info">
                    <span t-esc="user_login"/> / <span t-esc="operation_mode"/>
                </div>
                <pre t-esc="snapshot_json"/>
            </div>
        </t>
    </template>
    <template id="supreme_verification_page" name="Supreme Verification">
        <t t-call="web.layout">
            <div class="container mt16">
