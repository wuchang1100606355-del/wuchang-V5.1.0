<odoo>
    <template id="guardian_avatar_assets" name="Guardian Avatar Assets">
        <style>
            :root {
                --guardian-silver: #E0E0E0;
                --guardian-white: #F8FAFC;
                --magic-cyan: #00F3FF;
                --deep-space: #0B0E14;
                --glass-panel: rgba(255, 255, 255, 0.05);
                --glass-border: rgba(255, 255, 255, 0.1);
            }

            .guardian-container {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .avatar-float {
                animation: float 4s ease-in-out infinite;
            }

            @keyframes float {
                0% { transform: translateY(0px); }
                50% { transform: translateY(-10px); }
                100% { transform: translateY(0px); }
            }

            .halo-glow {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 200px;
                height: 200px;
                background: rgba(0, 243, 255, 0.05);
                border-radius: 50%;
                filter: blur(40px);
                z-index: -1;
                animation: pulse-glow 3s infinite alternate;
            }

            @keyframes pulse-glow {
                from { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
                to { opacity: 0.8; transform: translate(-50%, -50%) scale(1.1); }
            }

            .runic-text {
                font-family: monospace;
                font-size: 10px;
                fill: #333;
            }

            /* Comic Bubble Styles */
            .comic-bubble {
                position: relative;
                background: #fff;
                border: 3px solid #000;
                border-radius: 20px;
                padding: 20px;
                font-family: "Comic Sans MS", "Chalkboard SE", sans-serif;
                font-size: 1.1rem;
                color: #000;
                box-shadow: 5px 5px 0px rgba(0,0,0,0.2);
                margin: 20px;
                min-width: 200px;
                max-width: 100%;
                z-index: 10;
                display: inline-block;
            }

            /* Desktop: Bubble on the left of avatar (if avatar is on right) or right (if avatar is on left) */
            /* Assuming we want the bubble to be to the LEFT of the avatar by default or TOP */
            
            /* Bottom pointer (default, for stacked mobile) */
            .comic-bubble.bubble-bottom::after {
                content: "";
                position: absolute;
                bottom: -20px;
                left: 50%;
                margin-left: -20px;
                border-width: 20px 20px 0;
                border-style: solid;
                border-color: #000 transparent;
                display: block;
                width: 0;
            }
            .comic-bubble.bubble-bottom::before {
                content: "";
                position: absolute;
                bottom: -13px;
                left: 50%;
                margin-left: -17px;
                border-width: 17px 17px 0;
                border-style: solid;
                border-color: #fff transparent;
                display: block;
                width: 0;
                z-index: 1;
            }

            /* Right pointer (Bubble is on the left of the avatar) */
            .comic-bubble.bubble-right::after {
                content: "";
                position: absolute;
                top: 50%;
                right: -20px;
                margin-top: -20px;
                border-width: 20px 0 20px 20px;
                border-style: solid;
                border-color: transparent transparent transparent #000;
                display: block;
                width: 0;
            }
            .comic-bubble.bubble-right::before {
                content: "";
                position: absolute;
                top: 50%;
                right: -13px;
                margin-top: -17px;
                border-width: 17px 0 17px 17px;
                border-style: solid;
                border-color: transparent transparent transparent #fff;
                display: block;
                width: 0;
                z-index: 1;
            }

            /* Left pointer (Bubble is on the right of the avatar) */
            .comic-bubble.bubble-left::after {
                content: "";
                position: absolute;
                top: 50%;
                left: -20px;
                margin-top: -20px;
                border-width: 20px 20px 20px 0;
                border-style: solid;
                border-color: transparent #000 transparent transparent;
                display: block;
                width: 0;
            }
            .comic-bubble.bubble-left::before {
                content: "";
                position: absolute;
                top: 50%;
                left: -13px;
                margin-top: -17px;
                border-width: 17px 17px 17px 0;
                border-style: solid;
                border-color: transparent #fff transparent transparent;
                display: block;
                width: 0;
                z-index: 1;
            }

            .comic-text {
                font-weight: bold;
                line-height: 1.4;
            }
        </style>
    </template>

    <template id="guardian_avatar_svg" name="Guardian Avatar SVG">
        <div class="guardian-container">
            <div class="halo-glow"></div>
            <div class="avatar-float">
                <svg viewBox="0 0 200 240" style="width: 100%; height: 100%; max-width: 200px; drop-shadow: 0 0 15px rgba(255,255,255,0.3);">
                    <!-- Headpiece -->
                    <path d="M60 40 Q100 10 140 40 L140 70 Q100 80 60 70 Z" fill="#E0E0E0" stroke="#FFF" stroke-width="2"/>
                    <!-- Hair -->
                    <path d="M50 60 Q100 20 150 60 L160 180 Q100 200 40 180 Z" fill="#F5F5F5" />
                    <!-- Face -->
                    <ellipse cx="100" cy="90" rx="35" ry="40" fill="#FFF0E5" />
                    <!-- Eyes (Closed) -->
                    <path d="M85 95 Q100 100 115 95" stroke="#888" stroke-width="2" fill="none" />
                    <!-- Robes -->
                    <path d="M40 130 Q100 110 160 130 L180 230 Q100 240 20 230 Z" fill="#FFF" stroke="#E0E0E0" />
                    <!-- Hands (Praying) -->
                    <g transform="translate(85, 140)">
                        <path d="M0 0 L15 0 L15 25 L0 25 Z" fill="#FFF" stroke="#DDD" />
                        <path d="M15 0 L30 0 L30 25 L15 25 Z" fill="#FFF" stroke="#DDD" />
                        <!-- Runes on gloves -->
                        <text x="5" y="18" class="runic-text">ᚱ</text>
                        <text x="20" y="18" class="runic-text">ᚷ</text>
                    </g>
                </svg>
            </div>
        </div>
    </template>
</odoo>
