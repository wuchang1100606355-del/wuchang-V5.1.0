<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Accounting Journals per Store -->
        <record id="journal_pos_re_main" model="account.journal">
            <field name="name">POS 重新總店</field>
            <field name="type">sale</field>
            <field name="code">REPOS</field>
        </record>
        <record id="journal_pos_renyi" model="account.journal">
            <field name="name">POS 仁義分店</field>
            <field name="type">sale</field>
            <field name="code">RYPOS</field>
        </record>
        <record id="journal_pos_biz2" model="account.journal">
            <field name="name">POS 公益商家乙</field>
            <field name="type">sale</field>
            <field name="code">B2POS</field>
        </record>
        <record id="journal_pos_biz3" model="account.journal">
            <field name="name">POS 公益商家丙</field>
            <field name="type">sale</field>
            <field name="code">B3POS</field>
        </record>

        <!-- POS Configs per Store -->
        <record id="pos_config_re_main" model="pos.config">
            <field name="name">聊國咖啡重新總店</field>
            <field name="journal_id" ref="wuchang_core.journal_pos_re_main"/>
        </record>
        <record id="pos_config_renyi" model="pos.config">
            <field name="name">聊國咖啡仁義分店</field>
            <field name="journal_id" ref="wuchang_core.journal_pos_renyi"/>
        </record>
        <record id="pos_config_biz2" model="pos.config">
            <field name="name">細嚼慢嚥早餐店</field>
            <field name="journal_id" ref="wuchang_core.journal_pos_biz2"/>
            <field name="opening_time">06:00</field>
            <field name="closing_time">14:00</field>
            <field name="overnight">False</field>
            <field name="wuchang_delivery_fund_partner">True</field>
        </record>
        <record id="pos_config_biz3" model="pos.config">
            <field name="name">燒烤店</field>
            <field name="journal_id" ref="wuchang_core.journal_pos_biz3"/>
            <field name="opening_time">16:00</field>
            <field name="closing_time">05:00</field>
            <field name="overnight">True</field>
        </record>

        <!-- Fund pool attaches to 仁義分店 -->
        <record id="param_fund_pool_store" model="ir.config_parameter">
            <field name="key">wuchang.fund_pool_store</field>
            <field name="value">聊國咖啡仁義分店</field>
        </record>
    </data>
</odoo>
