    redir @pos /pos_simulator 302
    @ad path /ad
    redir @ad /pos_simulator?view=ad 302
    @menu path /menu
    redir @menu /pos_simulator?view=menu 302
    # handle_path /ops* {
    #     reverse_proxy uptime-kuma:3001
    # }
    # handle_path /portainer* {
