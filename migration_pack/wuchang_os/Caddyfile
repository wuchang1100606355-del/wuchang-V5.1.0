# Caddyfile for Wuchang OS

{
    # 全域設定（可選）
    # debug
}

# 根域與應用入口
wuchang.life, app.wuchang.life {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"
        -Server
    }
    @root path /
    redir @root /pos 301
    @pos path /pos
    redir @pos /pos_simulator 302
    @ad path /ad
    redir @ad /pos_simulator?view=ad 302
    @menu path /menu
    redir @menu /pos_simulator?view=menu 302
    # handle_path /ops* {
    #     reverse_proxy uptime-kuma:3001
    # }
    # handle_path /portainer* {
    #     reverse_proxy portainer:9000
    # }
    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200
    reverse_proxy wuchang-web:8069
}

wuchang.global, app.wuchang.global {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"
        -Server
