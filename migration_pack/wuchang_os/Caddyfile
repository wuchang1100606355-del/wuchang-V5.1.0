staff.wuchang.life {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072
    respond /health 200
    reverse_proxy wuchang-web:8069
}

staff.wuchang.global {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @bus path /longpolling*
    reverse_proxy @bus wuchang-web:8072 {
        transport http {
            read_timeout 90s
            write_timeout 90s
            dial_timeout 10s
            keepalive 30s
        }
    }
    respond /health 200
    reverse_proxy wuchang-web:8069 {
        transport http {
            read_timeout 60s
            write_timeout 60s
            dial_timeout 10s
            keepalive 30s
        }
    }
}

