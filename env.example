# ==============================================================================
# Wuchang v5.x - Unified Environment (single source of truth)
# Copy this file to `.env` and fill the values.
#
# Notes:
# - `.env` is ignored by git (secrets safe).
# - Docker Compose auto-loads `.env` in the same directory.
# - Host Python (FastAPI / scripts) can also read `.env` via scripts/env_align.*.
# ==============================================================================

# --- Shared security ---
# Protect FastAPI endpoints like /issue-certificate, /visiting-card, /google/workspace/*
WORKSHOP_API_KEY=CHANGE_ME

# --- Google Workspace (Admin SDK) bridge (Host Python / FastAPI) ---
# Path to service account JSON on the host (recommended: keep inside repo config/)
GOOGLE_WORKSPACE_SA_FILE=config/gcp-sa.json
# Domain-wide delegation impersonation user (must be an admin in Workspace)
GOOGLE_WORKSPACE_IMPERSONATE=admin@wuchang.life
# Optional local audit log file for Workspace bridge calls (JSONL)
GOOGLE_WORKSPACE_AUDIT_LOG=google_workspace_audit.jsonl

# --- Google ADC (Vertex AI / other GCP libs) ---
# For host Python, this can point to the same JSON as above.
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-sa.json

# --- Docker stack paths (host paths) ---
# Used by docker-compose.yml volumes (memory_store/common_store)
AI_MEMORY_PATH=/mnt/ai-memory
AI_COMMON_PATH=/mnt/ai-common

# --- Cloudflare tunnel (only needed if you run `cloudflared-named` profile) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Odoo (optional overrides; docker-compose has defaults) ---
ODOO_DB_HOST=db
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo
ODOO_DB_NAME=postgres

# --- Local service ports (informational / scripts) ---
FASTAPI_PORT=8080
ODOO_PORT=8069
OLLAMA_PORT=11434

