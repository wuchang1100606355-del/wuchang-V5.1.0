# 五常 AI - 網路環境配置

# ============================================
# 內網配置
# ============================================
INTERNAL_SERVER=192.168.50.249
INTERNAL_PORT=8766

# ============================================
# 外網配置
# ============================================
EXTERNAL_SERVER=wuchang.life
EXTERNAL_PORT=8766

# ============================================
# Google Workspace 配置
# ============================================
WORKSPACE_DOMAIN=wuchang.life
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================
# 自動連線配置
# ============================================
# 檢查間隔（秒）
CHECK_INTERVAL=30

# 自動切換
AUTO_DETECT_NETWORK=true

# 連線優先級（internal / external）
CONNECTION_PRIORITY=internal

# ============================================
# WiFi 配置
# ============================================
WIFI_SSID=WuchangAI_5G
WIFI_PASSWORD=

# ============================================
# VPN 配置（選配）
# ============================================
VPN_ENABLED=false
VPN_TYPE=wireguard
VPN_SERVER=wuchang.life
VPN_PORT=51820
VPN_PRIVATE_KEY=
VPN_PUBLIC_KEY=

# ============================================
# 安全配置
# ============================================
SYNC_SECRET=wuchang-sync-secret
USE_HTTPS=true
SSL_VERIFY=true

# ============================================
# Cloudflare 配置
# ============================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ============================================
# 外網設定
# ============================================
# 公網 IP（留空自動偵測）
PUBLIC_IP=

# 域名
DOMAIN=wuchang.life

# 子域名
SUBDOMAIN_SYNC=sync
SUBDOMAIN_API=api

# ============================================
# Nginx 設定
# ============================================
NGINX_PATH=C:\tools\nginx
NGINX_CONF_PATH=C:\tools\nginx\conf\wuchang.conf

# SSL 憑證路徑
SSL_CERT_PATH=C:\Certbot\live\wuchang.life\fullchain.pem
SSL_KEY_PATH=C:\Certbot\live\wuchang.life\privkey.pem
