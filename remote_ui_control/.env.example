# 五常 AI - 遠端 UI 控制系統配置

# ============================================
# 本機端配置 (192.168.50.84)
# ============================================
LOCAL_WS_HOST=0.0.0.0
LOCAL_WS_PORT=8765

# ============================================
# Server 端配置 (192.168.50.249)
# ============================================
SERVER_IP=192.168.50.249
LOCAL_CLIENT_IP=192.168.50.84
LOCAL_CLIENT_PORT=8765

# ============================================
# AI 路由策略（本地優先、雲端備援）
# ============================================
PREFER_LOCAL=true
FALLBACK_TIMEOUT=5

# ============================================
# 本機 AI 節點配置
# ============================================
# AI 類型: ollama, openai, custom
LOCAL_AI_TYPE=ollama

# 服務地址
LOCAL_AI_HOST=http://localhost:11434

# 使用的模型（建議輕量級模型）
# Ollama 推薦: gemma2:2b, llama3.2:3b, qwen2.5:3b
# OpenAI: gpt-3.5-turbo, gpt-4
LOCAL_AI_MODEL=gemma2:2b

# 請求超時（秒）
LOCAL_AI_TIMEOUT=30

# OpenAI API Key（如果使用 OpenAI 類型）
LOCAL_AI_API_KEY=

# ============================================
# 安全配置
# ============================================
# 共享密鑰（請務必修改為複雜密鑰）
WUCHANG_SECRET=wuchang-ui-secret-2026-change-this-key

# ============================================
# 重連配置
# ============================================
RECONNECT_INTERVAL=5
CONNECTION_TIMEOUT=10
PING_INTERVAL=30
PING_TIMEOUT=10

# ============================================
# 日誌配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=remote_ui_control.log
